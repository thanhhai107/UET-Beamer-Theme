\mode<presentation>
\ProvidesPackage{beamercolorthemeuet}[2026/10/31 UET color theme]

% =========================================================================
% TWO-TONE BLUE PALETTE: Dark Blue & Light Blue
% =========================================================================

% Dark Blue Palette (Primary Navy & Royal)
\definecolor{uetdarkblue}{HTML}{0D3B66}
\definecolor{uetblue}{HTML}{0D3B66}
\definecolor{uetblue9}{HTML}{092847}
\definecolor{uetblue8}{HTML}{0D3B66}
\definecolor{uetblue7}{HTML}{154DAE}
\definecolor{uetblue6}{HTML}{1F5EB8}

% Light Blue Palette (Accent, Secondary & Tints)
\definecolor{uetlightblue}{HTML}{4A90E2}
\definecolor{uetblue5}{HTML}{4A90E2}
\definecolor{uetblue4}{HTML}{6BA4E8}
\definecolor{uetblue3}{HTML}{91BAEE}
\definecolor{uetblue2}{HTML}{B8D3F4}
\definecolor{uetblue1}{HTML}{DCEAF9}
\definecolor{uetblue0}{HTML}{F0F6FD}

% Neutral Dark
\definecolor{uetblack}{HTML}{1E293B}

% Headline bar & subtitle line
\definecolor{frametitlebg}{HTML}{0D3B66}
\definecolor{framesubtitlebg}{HTML}{4A90E2}

% Global Beamer Elements
\setbeamercolor{palette primary}{fg=uetdarkblue,bg=uetblue0}
\setbeamercolor{palette secondary}{fg=uetlightblue,bg=uetblue1}
\setbeamercolor{palette tertiary}{fg=white,bg=uetdarkblue}
\setbeamercolor{titlelike}{fg=white}
\setbeamercolor{title}{fg=uetdarkblue}
\setbeamercolor{subtitle}{fg=uetlightblue}
\setbeamercolor{partname}{fg=uetdarkblue}
\setbeamercolor{section in toc}{fg=uetdarkblue}
\setbeamercolor{subsection in toc}{fg=uetblack}
\setbeamercolor{section number projected}{fg=white,bg=uetdarkblue}
\setbeamercolor{subsection number projected}{fg=white,bg=uetlightblue}
\setbeamercolor{subsubsection number projected}{fg=white,bg=uetlightblue}

% Items & Lists
\setbeamercolor{item}{fg=uetdarkblue,bg=uetlightblue}
\setbeamercolor{subitem}{fg=uetlightblue}
\setbeamercolor{subsubitem}{fg=uetblue6}

% Captions
\setbeamercolor{caption}{fg=uetblack}
\setbeamercolor{caption name}{fg=uetdarkblue}

% Header & Footer
\setbeamercolor{frametitle}{bg=uetdarkblue,fg=white}
\setbeamercolor{framesubtitle}{bg=uetlightblue,fg=white}
\setbeamercolor{page number in head/foot}{bg=uetlightblue,fg=white}

% Blocks (Dark Blue & Light Blue Theming)
\setbeamercolor{block title}{fg=white,bg=uetdarkblue}
\setbeamercolor{block body}{fg=uetblack,bg=uetblue0}

\setbeamercolor{block title alerted}{fg=white,bg=uetlightblue}
\setbeamercolor{block body alerted}{fg=uetblack,bg=uetblue1}

\setbeamercolor{block title example}{fg=white,bg=uetblue6}
\setbeamercolor{block body example}{fg=uetblack,bg=uetblue0}

\mode<all>
