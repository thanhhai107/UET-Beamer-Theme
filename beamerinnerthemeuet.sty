\ProvidesPackage{beamerinnerthemeuet}[UET inner theme]

\mode<presentation>
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{blocks}[rounded][shadow=false]

\setbeamertemplate{itemize item}{%
	\small\usebeamercolor[fg]{item}{\(\diamond\)}%
}
\setbeamertemplate{itemize subitem}{%
	\footnotesize\usebeamercolor[fg]{item}{\(\circ\)}%
}
\setbeamertemplate{itemize subsubitem}{%
	\scriptsize\usebeamercolor[fg]{item}{\(\star\)}%
}

\mode<all>
